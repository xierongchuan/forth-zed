{
  "Colon definition": {
    "prefix": "def",
    "body": [
      ": ${1:name} ( ${2:--} )",
      "  $0",
      ";"
    ],
    "description": "Define a Forth word with : ... ;"
  },
  "IF / THEN": {
    "prefix": "if",
    "body": [
      "if",
      "  $0",
      "then"
    ],
    "description": "Conditional block"
  },
  "IF / ELSE / THEN": {
    "prefix": "ife",
    "body": [
      "if",
      "  ${1}",
      "else",
      "  $0",
      "then"
    ],
    "description": "Conditional block with else branch"
  },
  "BEGIN / UNTIL": {
    "prefix": "beginu",
    "body": [
      "begin",
      "  $0",
      "until"
    ],
    "description": "Loop until flag becomes true"
  },
  "BEGIN / AGAIN": {
    "prefix": "begina",
    "body": [
      "begin",
      "  $0",
      "again"
    ],
    "description": "Infinite BEGIN/AGAIN loop"
  },
  "BEGIN / WHILE / REPEAT": {
    "prefix": "beginw",
    "body": [
      "begin",
      "  ${1:condition}",
      "while",
      "  $0",
      "repeat"
    ],
    "description": "BEGIN/WHILE/REPEAT loop"
  },
  "DO / LOOP": {
    "prefix": "do",
    "body": [
      "${1:limit} ${2:start} do",
      "  $0",
      "loop"
    ],
    "description": "Counted DO/LOOP"
  },
  "?DO / LOOP": {
    "prefix": "?do",
    "body": [
      "${1:limit} ${2:start} ?do",
      "  $0",
      "loop"
    ],
    "description": "Conditional counted loop"
  },
  "CASE": {
    "prefix": "case",
    "body": [
      "case",
      "  ${1:value} of",
      "    ${2}",
      "  endof",
      "  $0",
      "endcase"
    ],
    "description": "CASE/OF/ENDOF/ENDCASE"
  },
  "VARIABLE": {
    "prefix": "var",
    "body": [
      "variable ${1:name}"
    ],
    "description": "Define a variable"
  },
  "CONSTANT": {
    "prefix": "const",
    "body": [
      "${1:value} constant ${2:name}"
    ],
    "description": "Define a constant"
  },
  "VALUE": {
    "prefix": "value",
    "body": [
      "${1:value} value ${2:name}"
    ],
    "description": "Define a VALUE"
  },
  "CREATE / DOES>": {
    "prefix": "createdoes",
    "body": [
      "create ${1:name}",
      "  ${2}",
      "does>",
      "  $0"
    ],
    "description": "Create a defining word body"
  },
  "Print string": {
    "prefix": "dotstr",
    "body": [
      ".\" ${1:text}\"$0"
    ],
    "description": "Print a string with .\""
  },
  "String literal": {
    "prefix": "sstr",
    "body": [
      "s\" ${1:text}\"$0"
    ],
    "description": "Push string address and length with s\""
  },
  "OpenOS MMIO peek": {
    "prefix": "peek",
    "body": [
      "${1:addr} ${2:4} peek$0"
    ],
    "description": "OpenOS: read bytes from an absolute address"
  },
  "OpenOS MMIO poke": {
    "prefix": "poke",
    "body": [
      "${1:value} ${2:addr} ${3:4} poke$0"
    ],
    "description": "OpenOS: write bytes to an absolute address"
  },
  "OpenOS machine call": {
    "prefix": "call",
    "body": [
      "${1:arg} ${2:addr} call$0"
    ],
    "description": "OpenOS: call machine code at an address"
  },
  "OpenOS hex bytes": {
    "prefix": "hex,",
    "body": [
      "s\" ${1:hex bytes}\" hex,$0"
    ],
    "description": "OpenOS: decode/emit hexadecimal byte string"
  },
